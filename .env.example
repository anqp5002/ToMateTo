# Mẫu biến môi trường ToMateTo (S8). TẤT CẢ giá trị dưới đây là GIÁ TRỊ GIẢ.
# Sao chép thành .env rồi đổi khi chạy thật. KHÔNG commit .env (xem .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=tomateto
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=tomateto
POSTGRES_TEST_DB=tomateto_test
# Cổng chỉ mở trên loopback (127.0.0.1) cho máy dev; compose prod không mở 5432.
POSTGRES_HOST_PORT=5433

# --- Backend ---
BACKEND_PORT=8000
# Khi chạy trong compose: host là tên service "postgres".
DATABASE_URL=postgresql+psycopg://tomateto:change_me_dev_only@postgres:5432/tomateto
# Khi chạy trên máy (pytest, alembic): host là localhost, cổng đã map ra host.
DATABASE_URL_HOST=postgresql+psycopg://tomateto:change_me_dev_only@localhost:5433/tomateto
DATABASE_URL_TEST=postgresql+psycopg://tomateto:change_me_dev_only@localhost:5433/tomateto_test
# Ảnh: kho chính là Cloudinary (E3, 1.3_system_context), để trống ở S8; khoá thật chỉ để trong .env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Kho dự phòng cục bộ (local-private, volume "uploads" trong compose) khi tắt kho chính (NFR-10).
UPLOAD_DIR=/srv/uploads

# --- Xác thực (JWT) ---
JWT_SECRET=change_me_fake_secret_do_not_use
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7

# --- Thông báo đẩy (FCM) — để trống ở S8 ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
