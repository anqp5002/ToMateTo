# Copy to backend/.env and set local values before starting the application.
# Application configuration reads the environment. The shell must load this file.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/tomateto
JWT_SECRET=

# Use a separate test database. pytest creates/drops only its own temporary schema.
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/tomateto_test?connect_timeout=5
