# Copy to backend/.env and set local values before starting the application.
# Application configuration reads the environment. The shell must load this file.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/tomateto
JWT_SECRET=
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
# Proposed optional breaker, disabled until the project approves it.
AI_CIRCUIT_BREAKER_ENABLED=false
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RECOVERY_SECONDS=30
# Tag snapshots are an unapproved Q15 proposal; enable only after Lead/DB approval.
TRENDING_TAGS_ENABLED=false
CORS_ORIGINS=
# Temporary Hanoi test center; team must approve the deployment value.
ASSISTANT_DEFAULT_LATITUDE=21.0285
ASSISTANT_DEFAULT_LONGITUDE=105.8542

# Use a separate test database. pytest creates/drops only its own temporary schema.
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/tomateto_test?connect_timeout=5
