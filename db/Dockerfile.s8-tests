FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace
COPY db/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock
COPY db /workspace/db
COPY backend /workspace/backend
RUN pip install --no-deps --no-build-isolation -e /workspace/backend
CMD ["python", "-m", "pytest", "-c", "backend/pyproject.toml", "-q"]
